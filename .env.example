# Instacart Connect API key
# Get yours at: https://www.instacart.com/partner
INSTACART_API_KEY=your_instacart_connect_api_key_here

# USDA FoodData Central API key (for product search — free, higher rate limits than DEMO_KEY)
# Get yours at: https://fdc.nal.usda.gov/api-guide.html
FOODDATA_API_KEY=your_usda_fooddata_api_key_here

# Anthropic API key (for recipe extraction from screenshots and text)
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port for the backend server (default: 3001)
PORT=3001
